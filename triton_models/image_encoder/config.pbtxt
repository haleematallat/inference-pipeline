name: "image_encoder"
backend: "python"
max_batch_size: 32

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [3, -1, -1]
  }
]

output [
  {
    name: "embeddings"
    data_type: TYPE_FP32
    dims: [18]
  }
]

dynamic_batching {}

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
